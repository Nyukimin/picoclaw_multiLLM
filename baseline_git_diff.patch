+/* Layered Character Display */
+.character-layered {
+  position: relative;
+  width: 100%;
+  height: 100%;
+  display: inline-block;
+  overflow: hidden;
+}
+
+.character-part {
+  position: absolute;
+  object-fit: contain;
+  pointer-events: none;
+  image-rendering: -webkit-optimize-contrast;
+  image-rendering: crisp-edges;
+}
+
+.character-base {
+  z-index: 1;
+  /* Base fills the entire container - set by JS */
+}
+
+.character-eyebrow-left,
+.character-eyebrow-right {
+  z-index: 2;
+  /* Position and size set by JS based on bounds */
+}
+
+.character-eye-left,
+.character-eye-right {
+  z-index: 3;
+  /* Position and size set by JS based on bounds */
+}
+
+.character-mouth {
+  z-index: 4;
+  /* Position and size set by JS based on bounds */
+}
+
+.lipsync-actor .character-layered {
+  width: 256px;
+  height: 256px;
+}
