# RenCrow / picoclaw configuration example.
# Copy this file to config.yaml, then adjust hosts, paths, and environment
# variables for the machine that starts the Viewer.
#
# This example is derived from the active operations config under
# C:\Users\nyuki\.picoclaw\config.yaml, with secrets kept as environment
# variable references and host-local paths made safe for reuse.

server:
  host: "0.0.0.0"
  port: 18790

ollama:
  base_url: "http://100.83.207.6:11434"
  model: "Chat"
  worker_model: "Worker"
  max_context: 131072

local_llm:
  enabled: true
  provider: "local_openai"
  base_url: "http://127.0.0.1:8081"
  chat_base_url: "http://127.0.0.1:8081"
  worker_base_url: "http://127.0.0.1:8082"
  heavy_base_url: "http://127.0.0.1:8083"
  wild_base_url: "http://127.0.0.1:8084"
  api_key: ""
  chat_model: "Chat"
  worker_model: "Worker"
  chat_worker_model: "ChatWorker"
  heavy_model: "Heavy"
  wild_model: "Wild"
  timeout_sec: 120
  warmup: false
  global_concurrency: 2
  model_concurrency: 1

webwright_fetch:
  enabled: true
  runner_path: "tools/webwright_fetch/run_webwright_fetch.py"
  config_path: "tools/webwright_fetch/config_local_worker.yaml"
  output_dir: "tmp/webwright_runs"
  staging_output_dir: "tmp/webwright_staging"
  uvx_from: "git+https://github.com/microsoft/Webwright.git"
  responses_endpoint: "http://127.0.0.1:8082/v1/responses"
  model: "Coder1"
  api_key: ""

deepseek:
  api_key: "${DEEPSEEK_API_KEY}"
  model: "deepseek-chat"

openai:
  api_key: "${OPENAI_API_KEY}"
  model: "gpt-4o-mini"

claude:
  api_key: "${ANTHROPIC_API_KEY}"
  model: "claude-sonnet-4-20250514"

line:
  channel_secret: "${LINE_CHANNEL_SECRET}"
  access_token: "${LINE_CHANNEL_TOKEN}"

telegram:
  bot_token: "${TELEGRAM_BOT_TOKEN}"
  webhook_secret: "${TELEGRAM_WEBHOOK_SECRET}"

discord:
  bot_token: "${DISCORD_BOT_TOKEN}"
  public_key: "${DISCORD_PUBLIC_KEY}"

slack:
  app_token: "${SLACK_APP_TOKEN}"
  bot_token: "${SLACK_BOT_TOKEN}"
  signing_secret: "${SLACK_SIGNING_SECRET}"

google_search_chat:
  api_key: "${GOOGLE_API_KEY_CHAT}"
  search_engine_id: "${GOOGLE_SEARCH_ENGINE_ID_CHAT}"

google_search_worker:
  api_key: "${GOOGLE_API_KEY_WORKER}"
  search_engine_id: "${GOOGLE_SEARCH_ENGINE_ID_WORKER}"

session:
  storage_dir: "./sessions"

worker:
  auto_commit: false
  commit_message_prefix: "[Worker Auto-Commit]"
  command_timeout: 300
  git_timeout: 30
  stop_on_error: true
  workspace: "."
  protected_patterns:
    - ".env*"
    - "*credentials*"
    - "*.key"
    - "*.pem"
  action_on_protected: "error"
  show_execution_summary: true
  parallel_execution: false
  max_parallelism: 4

security:
  enabled: false
  policy_mode: "balanced"
  network_scope: ""
  network_allowlist:
    - "localhost"
    - "127.0.0.1"
  deny_commands:
    - "rm -rf"
    - "git reset --hard"
  workspace_enforced: true
  audit:
    enabled: true
    backend: "jsonl"
    path: "logs/execution_audit.jsonl"

prompts_dir: "./prompts"
workspace_dir: "./workspace"

log:
  level: "info"
  format: "json"

distributed:
  enabled: false
  transports:
    coder1:
      type: "local"
    coder2:
      type: "local"
    coder3:
      type: "ssh"
      remote_host: "192.168.1.25:22"
      remote_user: "nyuki"
      ssh_key_path: "~/.ssh/picoclaw_agent"
      strict_host_key: false
      remote_agent_path: "C:/Users/nyuki/.picoclaw/picoclaw-agent.exe"
      remote_config_path: "C:/Users/nyuki/.picoclaw/config.yaml"

idle_chat:
  enabled: true
  participants:
    - "mio"
    - "shiro"
  interval_min: 5
  interval_sec: 30
  max_turns: 100
  temperature: 0.8

conversation:
  enabled: true
  redis_url: "redis://localhost:6379"
  l1_sqlite_path: "./workspace/l1_memory.db"
  duckdb_path: "./workspace/memory.duckdb"
  vectordb_url: "localhost:6334"
  vector_collection: "picoclaw_memory_3584"
  vector_dimension: 3584
  embed_provider: "ollama"
  embed_base_url: "http://100.83.207.6:11434"
  embed_model: "nomic-embed-code:latest"
  summary_model: "Chat"

glossary:
  enabled: false
  db_path: "./workspace/glossary.db"
  refresh_interval_hr: 6
  max_entries: 8
  feed_urls:
    - "https://www3.nhk.or.jp/rss/news/cat0.xml"
    - "https://feeds.bbci.co.uk/news/world/rss.xml"
    - "https://feeds.bbci.co.uk/news/technology/rss.xml"

subagent:
  enabled: false
  max_iterations: 10
  provider: ""
  model: ""

heartbeat:
  enabled: true
  interval: 5
  channel: "line"
  chat_id: "${PICOCLAW_HEARTBEAT_CHAT_ID}"

tts:
  enabled: true
  output_dir: "./workspace/tts"
  cleanup_enabled: true
  retention_minutes: 30
  gc_interval_minutes: 10
  audio_path_root: "./scripts"
  http_base_url: "http://192.168.1.207:7870"
  ws_url: ""
  connect_timeout_ms: 3000
  receive_timeout_ms: 60000
  chunk_gap_timeout_ms: 3000
  voice_id: "mio"
  speed: 1.0
  speech_mode: "conversational"
  voice_servers: {}
  provider_priority:
    - "irodori"
  playback_commands: []
  irodori:
    enabled: true
    base_url: "http://192.168.1.207:7870"
    endpoint_path: "/api/tts"
    voice_id: "mio"
    voice_name: "Mio"
    reference_audio: "/Users/yukimi/GenerativeAI/TTS/irodori/voices/Female_01_Mio/reference.wav"
    reference_audio_url: "http://192.168.1.207:8090/voice_profile_tests/Female_01_Mio_test.wav"
    timeout_sec: 20
    checkpoint: "Aratako/Irodori-TTS-500M-v2"
    model_device: "mps"
    model_precision: "fp32"
    codec_device: "mps"
    codec_precision: "fp32"
    enable_watermark: false
    num_steps: 40
    num_candidates: 1
    cfg_guidance_mode: "independent"
    cfg_scale_text: 3.0
    cfg_scale_speaker: 5.0
    cfg_min_t: 0.5
    cfg_max_t: 1.0
    context_kv_cache: true
  azure:
    enabled: false
    endpoint: "${AZURE_TTS_ENDPOINT}"
    api_key: "${AZURE_TTS_API_KEY}"
    voice_name: "ja-JP-NanamiNeural"
    timeout_sec: 20
  eleven:
    enabled: false
    api_key: "${ELEVENLABS_API_KEY}"
    voice_id: ""
    model_id: "eleven_multilingual_v2"
    timeout_sec: 20

stt:
  enabled: true
  provider: "external_http"
  language: "ja"
  model: "small"
  timeout_ms: 8000
  provider_url: "http://192.168.1.207:8766/v1/audio/transcriptions"
  stream_url: "ws://192.168.1.207:8766/stt"

vtuber:
  enabled: false
  tick_interval_ms: 100
  connect_timeout_ms: 3000
  write_timeout_ms: 2000
  characters:
    mio:
      audio_output: "Audio-Out-Mio"
      vts_host: "127.0.0.1"
      vts_port: 8001
      expression_map:
        neutral: "ExpNeutral"
        happy: "ExpHappy"
        calm: "ExpCalm"
        thinking: "ExpThinking"
        surprised: "ExpSurprised"
        annoyed: "ExpAnnoyed"
        sad: "ExpSad"
    shiro:
      audio_output: "Audio-Out-Shiro"
      vts_host: "127.0.0.1"
      vts_port: 8002
      expression_map:
        neutral: "ExpNeutral"
        happy: "ExpHappy"
        calm: "ExpCalm"
        thinking: "ExpThinking"
        surprised: "ExpSurprised"
        annoyed: "ExpAnnoyed"
        sad: "ExpSad"

audio_router:
  enabled: false
  sse_url: "http://127.0.0.1:18790/audio-router/events"
  connect_timeout_ms: 5000
  download_timeout_ms: 15000
  retry_delay_ms: 2000
  buffer_ms: 120
  device_map:
    mio:
      device_id: "{0.0.0.00000000}.{MIO-DEVICE-ID}"
      display_name: "Audio-Out-Mio"
    shiro:
      device_id: "{0.0.0.00000000}.{SHIRO-DEVICE-ID}"
      display_name: "Audio-Out-Shiro"

coder1:
  enabled: true
  name: "aka"
  display_name: "赤"
  provider: "local_openai"
  model: "Coder1"
  base_url: "http://127.0.0.1:8082"
  api_key: ""
  light_memory:
    enabled: true
    max_turns: 3

coder2:
  enabled: true
  name: "ao"
  display_name: "青"
  provider: "local_openai"
  model: "Coder2"
  base_url: "http://127.0.0.1:8082"
  api_key: ""
  light_memory:
    enabled: true
    max_turns: 3

coder3:
  enabled: true
  name: "gin"
  display_name: "銀"
  provider: "local_openai"
  model: "Coder3"
  base_url: "http://127.0.0.1:8082"
  api_key: ""
  light_memory:
    enabled: true
    max_turns: 3

coder4:
  enabled: true
  name: "kin"
  display_name: "金"
  provider: "local_openai"
  model: "Coder4"
  base_url: "http://127.0.0.1:8082"
  api_key: ""
  light_memory:
    enabled: true
    max_turns: 3

llm_ops:
  enabled: true
  base_url: "http://192.168.1.207:8079"
